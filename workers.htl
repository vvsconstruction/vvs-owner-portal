<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>VVS Construction | Workers</title>

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
rel="stylesheet">

<style>

/* =====================================================
   GLOBAL
===================================================== */

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Poppins,sans-serif;
}

body{
background:#eef4fb;
color:#0b2545;
padding-bottom:90px;
}

/* =====================================================
   HEADER
===================================================== */

.header{

background:linear-gradient(
135deg,
#082a59,
#114d9a
);

color:white;

padding:18px;

display:flex;

justify-content:space-between;

align-items:center;

box-shadow:
0 8px 25px rgba(0,0,0,.18);

position:sticky;

top:0;

z-index:1000;

}

.headerLeft{

display:flex;

align-items:center;

gap:12px;

}

.backBtn{

width:42px;

height:42px;

border:none;

border-radius:12px;

background:#FFD700;

color:#082a59;

font-size:22px;

font-weight:700;

cursor:pointer;

}

.headerTitle h2{

font-size:20px;

}

.headerTitle small{

opacity:.8;

font-size:12px;

}

.addBtn{

background:#FFD700;

color:#082a59;

border:none;

padding:10px 15px;

border-radius:10px;

font-weight:700;

cursor:pointer;

}

.addBtn:hover{

background:#ffca00;

}

/* =====================================================
   CONTAINER
===================================================== */

.container{

padding:18px;

max-width:1400px;

margin:auto;

}

/* =====================================================
   MESSAGE
===================================================== */

.message{

padding:12px 15px;

border-radius:10px;

margin-bottom:15px;

display:none;

font-weight:600;

}

.message.show{

display:block;

}

.success{

background:#dcfce7;

color:#166534;

}

.error{

background:#fee2e2;

color:#991b1b;

}

/* =====================================================
   SUMMARY
===================================================== */

.summary{

display:grid;

grid-template-columns:
repeat(4,1fr);

gap:12px;

margin-bottom:18px;

}

.summaryBox{

background:white;

padding:16px;

border-radius:16px;

text-align:center;

box-shadow:
0 7px 18px rgba(0,0,0,.07);

}

.summaryBox p{

font-size:12px;

color:#777;

}

.summaryBox strong{

display:block;

font-size:26px;

margin-top:5px;

}

.blue{

color:#2563eb;

}

.green{

color:#16a34a;

}

.red{

color:#dc2626;

}

.purple{

color:#7c3aed;

}

/* =====================================================
   CARD
===================================================== */

.card{

background:white;

padding:18px;

border-radius:18px;

box-shadow:
0 8px 22px rgba(0,0,0,.08);

margin-bottom:18px;

}

.card h3{

color:#082a59;

margin-bottom:16px;

}

/* =====================================================
   FORM
===================================================== */

.formGrid{

display:grid;

grid-template-columns:
repeat(2,1fr);

gap:12px;

}

.field label{

display:block;

font-size:13px;

font-weight:600;

color:#555;

margin-bottom:6px;

}

input,
select{

width:100%;

padding:12px;

border:1px solid #d9dee7;

border-radius:10px;

outline:none;

font-size:14px;

background:white;

}

input:focus,
select:focus{

border-color:#2563eb;

}

.formActions{

display:flex;

gap:10px;

margin-top:15px;

}

.saveBtn{

background:#0b2545;

color:white;

border:none;

padding:12px 20px;

border-radius:10px;

font-weight:700;

cursor:pointer;

}

.saveBtn:hover{

background:#114d9a;

}

.saveBtn:disabled{

opacity:.6;

cursor:not-allowed;

}

.cancelBtn{

background:#e5e7eb;

color:#0b2545;

border:none;

padding:12px 20px;

border-radius:10px;

font-weight:700;

cursor:pointer;

display:none;

}

/* =====================================================
   SEARCH
===================================================== */

.searchCard{

background:white;

padding:15px;

border-radius:16px;

box-shadow:
0 7px 18px rgba(0,0,0,.07);

margin-bottom:15px;

}

.searchInput{

width:100%;

}

/* =====================================================
   TABLE
===================================================== */

.tableCard{

background:white;

border-radius:18px;

box-shadow:
0 8px 22px rgba(0,0,0,.08);

overflow:hidden;

}

.tableWrap{

overflow-x:auto;

}

table{

width:100%;

border-collapse:collapse;

min-width:900px;

}

thead th{

background:#0b2545;

color:white;

padding:13px;

text-align:left;

font-size:13px;

white-space:nowrap;

}

tbody td{

padding:12px;

border-bottom:1px solid #edf0f4;

font-size:13px;

white-space:nowrap;

}

tbody tr:hover{

background:#f8fafc;

}

/* =====================================================
   STATUS
===================================================== */

.status{

font-weight:700;

padding:5px 10px;

border-radius:20px;

font-size:11px;

}

.active{

background:#dcfce7;

color:#166534;

}

.inactive{

background:#fee2e2;

color:#991b1b;

}

/* =====================================================
   ACTION BUTTONS
===================================================== */

.actionBtn{

border:none;

padding:8px 11px;

border-radius:8px;

font-size:12px;

font-weight:600;

cursor:pointer;

}

.editBtn{

background:#2563eb;

color:white;

}

.deleteBtn{

background:#dc2626;

color:white;

margin-left:5px;

}

.editBtn:hover{

background:#1d4ed8;

}

.deleteBtn:hover{

background:#b91c1c;

}

/* =====================================================
   LOADING
===================================================== */

.loading{

padding:30px!important;

text-align:center;

color:#777;

}

/* =====================================================
   BOTTOM NAV
===================================================== */

.bottomNav{

position:fixed;

left:0;

right:0;

bottom:0;

background:white;

display:flex;

justify-content:space-around;

padding:10px 0;

box-shadow:
0 -5px 20px rgba(0,0,0,.12);

z-index:2000;

}

.bottomNav a{

text-decoration:none;

color:#0b2545;

font-size:12px;

text-align:center;

font-weight:600;

}

.bottomNav a.active{

color:#2563eb;

}

/* =====================================================
   DESKTOP
===================================================== */

@media(min-width:768px){

.bottomNav{

display:none;

}

}

/* =====================================================
   TABLET
===================================================== */

@media(max-width:900px){

.summary{

grid-template-columns:
repeat(2,1fr);

}

.formGrid{

grid-template-columns:
1fr;

}

}

/* =====================================================
   MOBILE
===================================================== */

@media(max-width:600px){

.header{

padding:14px;

}

.headerTitle h2{

font-size:17px;

}

.headerTitle small{

font-size:10px;

}

.addBtn{

padding:8px 10px;

font-size:12px;

}

.container{

padding:12px;

}

.summary{

grid-template-columns:
1fr 1fr;

gap:10px;

}

.summaryBox{

padding:14px;

}

.summaryBox strong{

font-size:22px;

}

.formActions{

flex-direction:column;

}

.saveBtn,
.cancelBtn{

width:100%;

}

}

/* =====================================================
   DESKTOP LARGE
===================================================== */

@media(min-width:1200px){

.container{

padding:25px;

}

}

</style>

</head>


<body>


<!-- =====================================================
     HEADER
===================================================== -->

<header class="header">

<div class="headerLeft">

<button
class="backBtn"
onclick="location.href='owner-dashboard.html'"
>
←
</button>

<div class="headerTitle">

<h2>
VVS Construction
</h2>

<small>
Worker Management
</small>

</div>

</div>


<button
class="addBtn"
onclick="startAddWorker()"
>
＋ Add Worker
</button>

</header>


<div class="container">


<!-- =====================================================
     MESSAGE
===================================================== -->

<div
id="message"
class="message"
></div>


<!-- =====================================================
     SUMMARY
===================================================== -->

<div class="summary">


<div class="summaryBox">

<p>
Total Workers
</p>

<strong
id="totalWorkers"
class="blue"
>
0
</strong>

</div>


<div class="summaryBox">

<p>
Active
</p>

<strong
id="activeWorkers"
class="green"
>
0
</strong>

</div>


<div class="summaryBox">

<p>
Inactive
</p>

<strong
id="inactiveWorkers"
class="red"
>
0
</strong>

</div>


<div class="summaryBox">

<p>
Daily Wage
</p>

<strong
id="totalWage"
class="purple"
>
₹0
</strong>

</div>


</div>


<!-- =====================================================
     ADD / EDIT WORKER
===================================================== -->

<div class="card">

<h3 id="formTitle">
👷 Add Worker
</h3>


<div class="formGrid">


<div class="field">

<label>
Worker Name
</label>

<input
id="name"
placeholder="Enter worker name"
autocomplete="name"
>

</div>


<div class="field">

<label>
Phone Number
</label>

<input
id="phone"
placeholder="10-digit mobile number"
inputmode="numeric"
maxlength="10"
>

</div>


<div class="field">

<label>
Aadhaar Number
</label>

<input
id="aadhaar"
placeholder="12-digit Aadhaar"
inputmode="numeric"
maxlength="12"
>

</div>


<div class="field">

<label>
Category
</label>

<select id="category">

<option value="Mason">
Mason
</option>

<option value="Helper">
Helper
</option>

<option value="Supervisor">
Supervisor
</option>

<option value="Electrician">
Electrician
</option>

<option value="Painter">
Painter
</option>

<option value="Carpenter">
Carpenter
</option>

<option value="Plumber">
Plumber
</option>

<option value="Welder">
Welder
</option>

<option value="Other">
Other
</option>

</select>

</div>


<div class="field">

<label>
Project
</label>

<input
id="project"
placeholder="Project name"
>

</div>


<div class="field">

<label>
Daily Wage ₹
</label>

<input
id="dailyWage"
type="number"
min="0"
placeholder="Daily wage"
>

</div>


<div class="field">

<label>
Status
</label>

<select id="status">

<option value="Active">
Active
</option>

<option value="Inactive">
Inactive
</option>

</select>

</div>


</div>


<div class="formActions">

<button
class="saveBtn"
id="saveBtn"
>
💾 Save Worker
</button>


<button
class="cancelBtn"
id="cancelBtn"
onclick="cancelEdit()"
>
Cancel Edit
</button>

</div>

</div>


<!-- =====================================================
     SEARCH
===================================================== -->

<div class="searchCard">

<input
class="searchInput"
id="search"
placeholder="🔍 Search worker by name, phone, category or project"
>

</div>


<!-- =====================================================
     WORKERS TABLE
===================================================== -->

<div class="tableCard">

<div class="tableWrap">

<table>

<thead>

<tr>

<th>
Worker
</th>

<th>
Phone
</th>

<th>
Category
</th>

<th>
Project
</th>

<th>
Daily Wage
</th>

<th>
Status
</th>

<th>
Action
</th>

</tr>

</thead>


<tbody id="workerTable">

<tr>

<td
colspan="7"
class="loading"
>

Loading workers...

</td>

</tr>

</tbody>

</table>

</div>

</div>


</div>


<!-- =====================================================
     BOTTOM NAV
===================================================== -->

<div class="bottomNav">

<a href="owner-dashboard.html">

🏠
<br>
Home

</a>


<a
href="workers.html"
class="active"
>

👷
<br>
Workers

</a>


<a href="attendance.html">

📅
<br>
Attendance

</a>


<a href="payroll.html">

💰
<br>
Payroll

</a>


<a href="projects.html">

📁
<br>
Projects

</a>

</div>


<!-- =====================================================
     FIREBASE
===================================================== -->

<script type="module">


import {

initializeApp

}

from

"https://www.gstatic.com/firebasejs/12.2.1/firebase-app.js";


import {

getFirestore,

collection,

addDoc,

onSnapshot,

deleteDoc,

updateDoc,

getDoc,

doc,

serverTimestamp

}

from

"https://www.gstatic.com/firebasejs/12.2.1/firebase-firestore.js";


import {

getAuth,

onAuthStateChanged

}

from

"https://www.gstatic.com/firebasejs/12.2.1/firebase-auth.js";


/* =====================================================
   FIREBASE CONFIG
===================================================== */

const firebaseConfig = {

apiKey:
"AIzaSyDQGsKaMXv-y7RadDHZBBHk1QDEWYuMt34",

authDomain:
"vvs-construction.firebaseapp.com",

projectId:
"vvs-construction",

storageBucket:
"vvs-construction.firebasestorage.app",

messagingSenderId:
"997782914494",

appId:
"1:997782914494:web:30e188d05e1607780fe5ef"

};


const app =
initializeApp(
firebaseConfig
);


const db =
getFirestore(
app
);


const auth =
getAuth(
app
);


/* =====================================================
   VARIABLES
===================================================== */

let editId = null;

let unsubscribeWorkers = null;


/* =====================================================
   AUTHENTICATION
===================================================== */

onAuthStateChanged(

auth,

(user) => {

if(!user){

window.location.href =
"owner-login.html";

return;

}

loadWorkers();

}

);


/* =====================================================
   LOAD WORKERS
===================================================== */

function loadWorkers(){

if(unsubscribeWorkers){

unsubscribeWorkers();

}


unsubscribeWorkers =
onSnapshot(

collection(
db,
"workers"
),

(snap) => {

renderWorkers(
snap
);

},

(error) => {

console.error(
"Workers error:",
error
);

showMessage(
"Unable to load workers.",
"error"
);

}

);

}


/* =====================================================
   RENDER WORKERS
===================================================== */

function renderWorkers(
snap
){

const tbody =
document.getElementById(
"workerTable"
);


tbody.innerHTML = "";


let total = 0;

let active = 0;

let inactive = 0;

let totalWage = 0;


if(snap.empty){

tbody.innerHTML = `

<tr>

<td
colspan="7"
class="loading"
>

No workers found.

</td>

</tr>

`;

updateStats(
0,
0,
0,
0
);

return;

}


snap.forEach(

(workerDoc) => {

const d =
workerDoc.data();

const id =
workerDoc.id;


total++;


if(
d.status === "Active"
){

active++;

}else{

inactive++;

}


totalWage +=
Number(
d.dailyWage || 0
);


const row =
document.createElement(
"tr"
);


row.innerHTML = `

<td>

<b>
${escapeHTML(
d.name || "-"
)}
</b>

</td>


<td>

${escapeHTML(
d.phone || "-"
)}

</td>


<td>

${escapeHTML(
d.category || "-"
)}

</td>


<td>

${escapeHTML(
d.project || "-"
)}

</td>


<td>

₹${Number(
d.dailyWage || 0
).toLocaleString(
"en-IN"
)}

</td>


<td>

<span
class="status ${
d.status === "Active"
? "active"
: "inactive"
}"
>

${escapeHTML(
d.status || "Inactive"
)}

</span>

</td>


<td>

<button
class="actionBtn editBtn"
>
✏️ Edit
</button>


<button
class="actionBtn deleteBtn"
>
🗑️ Delete
</button>

</td>

`;


tbody.appendChild(
row
);


row.querySelector(
".editBtn"
).addEventListener(

"click",

() => {

editWorker(
id
);

}

);


row.querySelector(
".deleteBtn"
).addEventListener(

"click",

() => {

deleteWorker(
id
);

}

);

}

);


updateStats(
total,
active,
inactive,
totalWage
);

}


/* =====================================================
   UPDATE STATS
===================================================== */

function updateStats(
total,
active,
inactive,
wage
){

document.getElementById(
"totalWorkers"
).textContent =
total;


document.getElementById(
"activeWorkers"
).textContent =
active;


document.getElementById(
"inactiveWorkers"
).textContent =
inactive;


document.getElementById(
"totalWage"
).textContent =
"₹" +
wage.toLocaleString(
"en-IN"
);

}


/* =====================================================
   SAVE WORKER
===================================================== */

async function saveWorker(){

const name =
document.getElementById(
"name"
).value.trim();


const phone =
document.getElementById(
"phone"
).value.trim();


const aadhaar =
document.getElementById(
"aadhaar"
).value.trim();


const category =
document.getElementById(
"category"
).value;


const project =
document.getElementById(
"project"
).value.trim();


const dailyWage =
Number(
document.getElementById(
"dailyWage"
).value || 0
);


const status =
document.getElementById(
"status"
).value;


/* =========================
   VALIDATION
========================= */

if(!name){

showMessage(
"Please enter worker name.",
"error"
);

return;

}


if(
phone &&
!/^[6-9]\d{9}$/.test(
phone
)
){

showMessage(
"Enter a valid 10-digit Indian mobile number.",
"error"
);

return;

}


if(
aadhaar &&
!/^\d{12}$/.test(
aadhaar
)
){

showMessage(
"Aadhaar number must contain 12 digits.",
"error"
);

return;

}


if(
dailyWage < 0
){

showMessage(
"Daily wage cannot be negative.",
"error"
);

return;

}


const saveBtn =
document.getElementById(
"saveBtn"
);


saveBtn.disabled =
true;


saveBtn.textContent =
editId
? "Updating..."
: "Saving...";


try{


const workerData = {

name:name,

phone:phone,

aadhaar:aadhaar,

category:category,

project:project,

dailyWage:dailyWage,

status:status,

updatedAt:
serverTimestamp()

};


if(editId){

await updateDoc(

doc(
db,
"workers",
editId
),

workerData

);


showMessage(
"✅ Worker updated successfully.",
"success"
);


}else{

await addDoc(

collection(
db,
"workers"
),

{

...workerData,

createdAt:
serverTimestamp()

}

);


showMessage(
"✅ Worker added successfully.",
"success"
);

}


clearForm();


}catch(error){

console.error(
"Save worker error:",
error
);


showMessage(
"Unable to save worker. Please try again.",
"error"
);

}


saveBtn.disabled =
false;


saveBtn.textContent =
"💾 Save Worker";

}


/* =====================================================
   EDIT WORKER
===================================================== */

async function editWorker(
id
){

try{

const snap =
await getDoc(

doc(
db,
"workers",
id
)

);


if(!snap.exists()){

showMessage(
"Worker not found.",
"error"
);

return;

}


const d =
snap.data();


document.getElementById(
"name"
).value =
d.name || "";


document.getElementById(
"phone"
).value =
d.phone || "";


document.getElementById(
"aadhaar"
).value =
d.aadhaar || "";


document.getElementById(
"category"
).value =
d.category || "Other";


document.getElementById(
"project"
).value =
d.project || "";


document.getElementById(
"dailyWage"
).value =
d.dailyWage || 0;


document.getElementById(
"status"
).value =
d.status || "Active";


editId =
id;


document.getElementById(
"formTitle"
).textContent =
"✏️ Edit Worker";


document.getElementById(
"saveBtn"
).textContent =
"Update Worker";


document.getElementById(
"cancelBtn"
).style.display =
"block";


window.scrollTo({

top:0,

behavior:"smooth"

});


document.getElementById(
"name"
).focus();


}catch(error){

console.error(
"Edit worker error:",
error
);


showMessage(
"Unable to load worker.",
"error"
);

}

}


/* =====================================================
   DELETE WORKER
===================================================== */

async function deleteWorker(
id
){

const confirmed =
confirm(

"Are you sure you want to delete this worker?\n\nExisting attendance records will remain."

);


if(!confirmed){

return;

}


try{

await deleteDoc(

doc(
db,
"workers",
id
)

);


showMessage(
"🗑️ Worker deleted successfully.",
"success"
);


}catch(error){

console.error(
"Delete worker error:",
error
);


showMessage(
"Unable to delete worker.",
"error"
);

}

}


/* =====================================================
   ADD WORKER
===================================================== */

window.startAddWorker =
function(){

clearForm();


document.getElementById(
"name"
).focus();


window.scrollTo({

top:0,

behavior:"smooth"

});

};


/* =====================================================
   CANCEL EDIT
===================================================== */

window.cancelEdit =
function(){

clearForm();

};


/* =====================================================
   CLEAR FORM
===================================================== */

function clearForm(){

editId = null;


document.getElementById(
"name"
).value = "";


document.getElementById(
"phone"
).value = "";


document.getElementById(
"aadhaar"
).value = "";


document.getElementById(
"category"
).value =
"Mason";


document.getElementById(
"project"
).value = "";


document.getElementById(
"dailyWage"
).value = "";


document.getElementById(
"status"
).value =
"Active";


document.getElementById(
"formTitle"
).textContent =
"👷 Add Worker";


document.getElementById(
"saveBtn"
).textContent =
"💾 Save Worker";


document.getElementById(
"cancelBtn"
).style.display =
"none";

}


/* =====================================================
   SEARCH
===================================================== */

document.getElementById(
"search"
).addEventListener(

"input",

function(){

const value =
this.value
.toLowerCase()
.trim();


document.querySelectorAll(
"#workerTable tr"
).forEach(

(row) => {

row.style.display =

row.innerText
.toLowerCase()
.includes(value)

? ""

: "none";

}

);

}

);


/* =====================================================
   MESSAGE
===================================================== */

function showMessage(
text,
type
){

const message =
document.getElementById(
"message"
);


message.textContent =
text;


message.className =
"message show " +
type;


setTimeout(

() => {

message.className =
"message";

},

4000

);

}


/* =====================================================
   HTML SECURITY
===================================================== */

function escapeHTML(
value
){

return String(
value
)

.replaceAll(
"&",
"&amp;"
)

.replaceAll(
"<",
"&lt;"
)

.replaceAll(
">",
"&gt;"
)

.replaceAll(
'"',
"&quot;"
)

.replaceAll(
"'",
"&#039;"
);

}


/* =====================================================
   SAVE BUTTON
===================================================== */

document.getElementById(
"saveBtn"
).addEventListener(

"click",

saveWorker

);

</script>

</body>

</html>
